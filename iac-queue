cmd_label() {
    [[ $# -ge 1 && $# -le 2 ]] || {
        die "label requires a key and optional LABEL or --clear"
    }

    local key_hash="$1"
    local namespace
    local label_file
    local temp_label

    validate_key_hash "$key_hash"
    ensure_runtime
    acquire_record_lock "$key_hash" "__namespace_label__"

    namespace="$(namespace_path "$key_hash")"
    label_file="$namespace/label"

    if [[ $# -eq 1 ]]; then
        namespace_label "$key_hash"
        return 0
    fi

    if [[ "$2" == "--clear" ]]; then
