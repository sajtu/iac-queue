cmd_prune() {
    [[ $# -eq 0 ]] || die "--prune does not accept arguments"

    ensure_runtime
    acquire_maintenance_lock true
    migrate_legacy_keys
    abort_stale_tasks "$PRUNE_MINIMUM_DAYS" "manual-prune"
    printf 'Pruned %s task(s) aged at least %s days.\n' \
        "$MAINTENANCE_ABORTED_COUNT" "$PRUNE_MINIMUM_DAYS"
}

terminal_record_epoch() {
    local item_path="$1"
    local epoch=""

    if [[ -f "$item_path/terminal_epoch" ]]; then
        IFS= read -r epoch < "$item_path/terminal_epoch" || true
    fi

    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$epoch"
        return 0
    fi

    # Compatibility for records completed before terminal_epoch was added.
    if [[ -f "$item_path/result" ]]; then
        if epoch="$(stat -c '%Y' "$item_path/result" 2>/dev/null)" ||
           epoch="$(stat -f '%m' "$item_path/result" 2>/dev/null)"; then
            if [[ "$epoch" =~ ^[0-9]+$ ]]; then
                printf '%s\n' "$epoch"
                return 0
            fi
        fi
    fi

    return 1
}

cmd_cleanup() {
    [[ $# -eq 1 ]] || die "cleanup requires one DAYS value"
    [[ "$1" =~ ^[0-9]+$ ]] || die "cleanup DAYS must be zero or a positive integer"

    local retention_days="$1"
    local threshold_seconds="$((retention_days * 86400))"
    local now_epoch
    local state
    local state_dir
    local item_path
    local queue_id
    local external_id
    local terminal_epoch
    local age_seconds
    local destination
    local moved_count=0

    ensure_runtime
    acquire_maintenance_lock true
    now_epoch="$(date '+%s')"

    for state in completed abort; do
        case "$state" in
            completed) state_dir="$COMPLETED_DIR" ;;
            abort) state_dir="$ABORT_DIR" ;;
        esac

        shopt -s nullglob
        for item_path in "$state_dir"/*; do
            [[ -d "$item_path" ]] || continue
            terminal_epoch="$(terminal_record_epoch "$item_path" || true)"
            [[ "$terminal_epoch" =~ ^[0-9]+$ ]] || continue
            age_seconds="$((now_epoch - terminal_epoch))"
            (( age_seconds >= threshold_seconds )) || continue

            queue_id="$(basename "$item_path")"
            key_hash="$(cat "$item_path/key_sha256" 2>/dev/null || true)"
            external_id="$(cat "$item_path/external_id" 2>/dev/null || printf '-')"
            [[ "$key_hash" =~ ^[0-9a-f]{64}$ ]] || continue
            acquire_record_lock "$key_hash" "$external_id"

            # Another process may already have moved this terminal record.
            if [[ ! -d "$item_path" ]]; then
                release_record_lock
                continue
            fi

            destination="$TRASH_DIR/$queue_id"
            [[ ! -e "$destination" ]] || {
                die "trash already contains queue record $queue_id"
            }

            printf '%s\n' "$(now_iso)" > "$item_path/updated_at"
            append_history "$item_path" "trashed" \
                "$state record retained for at least $retention_days day(s)"
            mv -- "$item_path" "$destination"
            write_log "trashed" "$external_id" \
                "$queue_id from $state after $retention_days day(s)"
            moved_count=$((moved_count + 1))
            release_record_lock
        done
        shopt -u nullglob
    done

    printf 'Moved %s terminal task(s) to trash.\n' "$moved_count"
}

cmd_purge_trash() {
    [[ $# -eq 1 && "$1" == "--yes" ]] || {
        die "purge-trash permanently deletes trash; confirm with --yes"
    }

    local item_path
    local purged_count=0

    ensure_runtime
    acquire_maintenance_lock true

    shopt -s nullglob
    for item_path in "$TRASH_DIR"/*; do
        [[ -d "$item_path" ]] || continue
        find "$item_path" -depth -delete
        purged_count=$((purged_count + 1))
    done
    shopt -u nullglob

    write_log "trash-purged" "-" "$purged_count record(s)"
    printf 'Permanently deleted %s task(s) from trash.\n' "$purged_count"
}

run_automatic_maintenance() {
    if ! acquire_maintenance_lock false; then
        return 0
    fi

    migrate_legacy_keys
    abort_stale_tasks "$AUTO_ABORT_DAYS" "automatic-expiration"
    release_maintenance_lock
}

main() {
    local command
    local command_uses_key="false"

    if [[ "${1:-}" == "--key-file" ]]; then
        [[ $# -ge 3 ]] || die "--key-file requires FILE followed by COMMAND"
        KEY_FILE_OPTION="$2"
        shift 2
    fi

    command="${1:-}"

    if [[ -z "$command" ]]; then
        usage
        exit 1
    fi

    shift

    case "$command" in
        add|cancel|start|complete|push|peek|shift|backlog|inprogress|completed|abort|show|label)
            command_uses_key="true"
            ;;
    esac

    if [[ "$command_uses_key" == "true" ]]; then
        COMMAND_KEY_ARGUMENT_CONSUMED="false"
        resolve_command_key "$@"
        if [[ "$COMMAND_KEY_ARGUMENT_CONSUMED" == "true" ]]; then
            shift
        fi
        set -- "$RESOLVED_KEY_HASH" "$@"
    elif [[ -n "$KEY_FILE_OPTION" ]]; then
        die "--key-file is not supported for '$command'"
    fi

    case "$command" in
        install|version|--version|-V|help|--help|-h|--prune|cleanup|purge-trash)
            ;;
        *)
            ensure_runtime
            run_automatic_maintenance
            ;;
    esac

    case "$command" in
        install) cmd_install "$@" ;;
        add) cmd_add "$@" ;;
        cancel) cmd_cancel "$@" ;;
        start) cmd_start "$@" ;;
        complete) cmd_complete "$@" ;;
        push) cmd_push "$@" ;;
        peek) cmd_peek "$@" ;;
        shift) cmd_shift "$@" ;;
        backlog) list_state "backlog" "$@" ;;
        inprogress) list_state "inprogress" "$@" ;;
        completed) list_state "completed" "$@" ;;
        abort) list_state "abort" "$@" ;;
        show) cmd_show "$@" ;;
        label) cmd_label "$@" ;;
        cleanup) cmd_cleanup "$@" ;;
        purge-trash) cmd_purge_trash "$@" ;;
        --prune) cmd_prune "$@" ;;
        version|--version|-V)
            printf '%s %s\n' "$PROGRAM" "$VERSION"
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            usage >&2
            die "unknown command '$command'"
            ;;
    esac
}

main "$@"

