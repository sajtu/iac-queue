    write_log "message-shifted" "$external_id" \
        "$ITEM_QUEUE_ID $OLDEST_MESSAGE_ID"
}

list_state() {
    local state="$1"
    shift

    [[ $# -ge 1 ]] || die "$state requires a key"

    local key_hash="$1"
    shift
    local long_output="false"
    local show_queue_id="false"
    local state_dir
    local item_path
    local queue_id
    local external_id
    local item_key_hash
    local label
    local order
    local created
    local created_epoch
    local age_days
    local now_epoch
    local result
    local messages
    local rows=()
    local output_rows=()

    validate_key_hash "$key_hash"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --long)
                long_output="true"
                ;;
            --show-queueid|--display-queue-id)
                show_queue_id="true"
                ;;
            *)
                die "unsupported queue listing option '$1'"
                ;;
        esac
        shift
    done

    if [[ "$show_queue_id" == "true" && "$long_output" != "true" ]]; then
        die "--show-queueid and --display-queue-id require --long"
    fi

    case "$state" in
        backlog) state_dir="$BACKLOG_DIR" ;;
        inprogress) state_dir="$INPROGRESS_DIR" ;;
        completed) state_dir="$COMPLETED_DIR" ;;
        abort) state_dir="$ABORT_DIR" ;;
        *) die "unknown queue state: $state" ;;
    esac

    ensure_runtime
    now_epoch="$(date '+%s')"

    shopt -s nullglob
    for item_path in "$state_dir"/*; do
        [[ -d "$item_path" ]] || continue
        queue_id="$(basename "$item_path")"
        [[ -f "$item_path/key_sha256" ]] || continue
        [[ -f "$item_path/external_id" ]] || continue
        item_key_hash="$(cat "$item_path/key_sha256")"
        [[ "$item_key_hash" == "$key_hash" ]] || continue
        order="$(cat "$item_path/created_order" 2>/dev/null || printf '0')"
        rows+=("$order"$'\t'"$queue_id")
    done
    shopt -u nullglob

    if [[ "$long_output" == "true" ]]; then
        if [[ "$show_queue_id" == "true" ]]; then
            output_rows+=(
                $'QUEUE_ID\tLABEL\tEXTERNAL_ID\tSTATE\tCREATED\tAGE_DAYS\tRESULT\tMESSAGES'
            )
        else
            output_rows+=(
                $'LABEL\tEXTERNAL_ID\tSTATE\tCREATED\tAGE_DAYS\tRESULT\tMESSAGES'
            )
        fi
    fi

    if [[ ${#rows[@]} -eq 0 ]]; then
        if [[ "$long_output" == "true" ]]; then
            if command -v column >/dev/null 2>&1; then
                printf '%s\n' "${output_rows[@]}" | column -t -s $'\t'
            else
                printf '%s\n' "${output_rows[@]}"
            fi
        fi
        return 0
    fi

    label="$(namespace_label "$key_hash")"

    while IFS=$'\t' read -r order queue_id; do
        item_path="$state_dir/$queue_id"
        external_id="$(cat "$item_path/external_id")"

        if [[ "$long_output" == "true" ]]; then
            created="$(cat "$item_path/created_at" 2>/dev/null || true)"
            created_epoch="$(cat "$item_path/created_epoch" 2>/dev/null || true)"
            if [[ "$created_epoch" =~ ^[0-9]+$ ]]; then
                age_days="$(((now_epoch - created_epoch) / 86400))"
            else
                age_days="-"
            fi
            result="$(cat "$item_path/result" 2>/dev/null || true)"
            messages="$(message_count "$item_path")"
            if [[ "$show_queue_id" == "true" ]]; then
                output_rows+=(
                    "$queue_id"$'\t'"$label"$'\t'"$external_id"$'\t'"$state"$'\t'"$created"$'\t'"$age_days"$'\t'"${result:--}"$'\t'"$messages"
                )
            else
                output_rows+=(
                    "$label"$'\t'"$external_id"$'\t'"$state"$'\t'"$created"$'\t'"$age_days"$'\t'"${result:--}"$'\t'"$messages"
                )
            fi
        else
            printf '%s\n' "$external_id"
        fi
    done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -k1,1n -k2,2)

    if [[ "$long_output" == "true" ]]; then
        if command -v column >/dev/null 2>&1; then
            printf '%s\n' "${output_rows[@]}" | column -t -s $'\t'
        else
            printf '%s\n' "${output_rows[@]}"
        fi
    fi
}

cmd_show() {
