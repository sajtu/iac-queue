#!/usr/bin/env bash
#
# iac-queue - a small, provider-neutral, directory-backed task queue.
#
# The caller supplies an opaque key and external ID. The key is hashed before
# use and is never stored or displayed in its original form. iac-queue assigns
# its own internal queue ID and never interprets the external ID or message.
#

set -euo pipefail

PROGRAM="iac-queue"
VERSION="0.9.1"
MAX_MESSAGES="${IAC_QUEUE_MAX_MESSAGES:-10}"
MAX_MESSAGE_BYTES="${IAC_QUEUE_MAX_MESSAGE_BYTES:-8192}"
AUTO_ABORT_DAYS=366
PRUNE_MINIMUM_DAYS=31

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF_PATH")"

if [[ -n "${IAC_QUEUE_ROOT:-}" ]]; then
    ROOT="$(readlink -f "$IAC_QUEUE_ROOT")"
elif [[ "$(basename "$SELF_DIR")" == "bin" ]]; then
    ROOT="$(dirname "$SELF_DIR")"
else
    ROOT="$SELF_DIR"
fi

QUEUE_ROOT="$ROOT/queue"
BACKLOG_DIR="$QUEUE_ROOT/backlog"
INPROGRESS_DIR="$QUEUE_ROOT/inprogress"
COMPLETED_DIR="$QUEUE_ROOT/completed"
ABORT_DIR="$QUEUE_ROOT/abort"
TRASH_DIR="$QUEUE_ROOT/trash"
LOG_DIR="$ROOT/logs"
LOG_FILE="$LOG_DIR/iac-queue.log"
LOCK_ROOT="$LOG_DIR/locks"
RECORD_LOCK_ROOT="$LOCK_ROOT/records"
COUNTER_LOCK_FILE="$LOCK_ROOT/counter.lock"
COUNTER_LOCK_DIR="$LOCK_ROOT/counter.lock.d"
MAINTENANCE_LOCK_FILE="$LOCK_ROOT/maintenance.lock"
MAINTENANCE_LOCK_DIR="$LOCK_ROOT/maintenance.lock.d"
NEXT_ID_FILE="$QUEUE_ROOT/next_id"
NAMESPACE_DIR="$QUEUE_ROOT/namespaces"
RECORD_LOCK_METHOD=""
RECORD_LOCK_DIR=""
COUNTER_LOCK_METHOD=""
MAINTENANCE_LOCK_METHOD=""
TEMP_PAYLOAD_FILE=""
TEMP_RECORD_DIR=""
TEMP_MESSAGE_DIR=""
KEY_FILE_OPTION=""
RESOLVED_KEY_HASH=""

usage() {
    cat <<'EOF'
Usage:
  iac-queue [--key-file FILE] COMMAND ...
  iac-queue install TARGET
  iac-queue add KEY EXTERNAL_ID [MESSAGE...]
  iac-queue add KEY EXTERNAL_ID --file FILE
  iac-queue add KEY EXTERNAL_ID --stdin
  iac-queue cancel KEY EXTERNAL_ID [NOTE...]
  iac-queue start KEY EXTERNAL_ID [NOTE...]
  iac-queue complete KEY EXTERNAL_ID [NOTE...]
  iac-queue push KEY EXTERNAL_ID MESSAGE...
  iac-queue push KEY EXTERNAL_ID --file FILE
  iac-queue push KEY EXTERNAL_ID --stdin
  iac-queue peek KEY EXTERNAL_ID
  iac-queue shift KEY EXTERNAL_ID
  iac-queue backlog KEY [--long]
  iac-queue inprogress KEY [--long]
  iac-queue completed KEY [--long]
  iac-queue abort KEY [--long]
  iac-queue show KEY EXTERNAL_ID
  iac-queue label KEY [LABEL|--clear]
  iac-queue cleanup DAYS
  iac-queue purge-trash --yes
  iac-queue version

Key input:
  Commands that require KEY may receive it in one of three ways:

      iac-queue COMMAND KEY ...
      iac-queue --key-file FILE COMMAND ...
      IAC_QUEUE_KEY="..." iac-queue COMMAND ...

  When --key-file or IAC_QUEUE_KEY is used, omit KEY after COMMAND.
  --key-file takes precedence over IAC_QUEUE_KEY.

Install:
  TARGET is the parent directory. The installation is created at:

      TARGET/iac-queue/

  If the installation is inside a Git worktree, only these runtime paths
  are added to that repository's .gitignore:

      iac-queue/bin/
      iac-queue/logs/

  Queue records are not ignored and may be tracked by Git.

Queue behavior:
  add       Add a new task to backlog. Existing external IDs are ignored.
  cancel    Move backlog/in-progress task to completed as cancelled.
  start     Move a backlog task to inprogress.
  complete  Move an in-progress task to completed as successful.
  push      Append an ASCII message to a task's message queue.
  peek      Read the oldest message without removing it.
  shift     Read and remove the oldest message.

Listings are FIFO. Without --long, listings print one external ID per line.
The abort queue is read-only and contains automatically expired tasks.

cleanup moves completed and aborted tasks at least DAYS old into the untracked
trash directory. If cleanup is never run, terminal records are retained.
purge-trash --yes permanently deletes every record currently in trash.

Every task belongs to one caller-defined key. The key is mandatory for every
task operation and listing. There is no unfiltered listing command.

Keys are logical namespaces and filters, not authentication credentials.
Original keys are not stored or displayed. Optional labels are descriptive
only and are never accepted in place of a key.

The caller chooses an arbitrary, single-line external ID. iac-queue assigns
its own internal queue ID. External-ID uniqueness is scoped to the key.

The optional MESSAGE supplied to add becomes the first queued message.
Messages are ASCII plaintext and are not interpreted by iac-queue. Providers
must encrypt and ASCII-encode sensitive payloads before adding them.

Defaults per task:
  Maximum messages:       10
  Maximum message bytes:  8192

Completed, cancelled, and aborted tasks have their message payload files
removed from the queue record.
EOF
}

die() {
    printf '%s: ERROR: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

now_iso() {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
}

actor_name() {
    if [[ -n "${IAC_QUEUE_ACTOR:-}" ]]; then
        printf '%s\n' "$IAC_QUEUE_ACTOR"
    else
        id -un
    fi
}

sanitize_note() {
    printf '%s' "$*" | tr '\t\r\n' '   '
}

set_shared_directory_mode() {
    if ! chmod 2770 "$@" 2>/dev/null; then
        chmod 0770 "$@"
    fi
}

ensure_runtime() {
    [[ "$MAX_MESSAGES" =~ ^[1-9][0-9]*$ ]] || {
        die "IAC_QUEUE_MAX_MESSAGES must be a positive integer"
    }
    [[ "$MAX_MESSAGE_BYTES" =~ ^[1-9][0-9]*$ ]] || {
        die "IAC_QUEUE_MAX_MESSAGE_BYTES must be a positive integer"
    }

    umask 0007
    mkdir -p \
        "$BACKLOG_DIR" \
        "$INPROGRESS_DIR" \
        "$COMPLETED_DIR" \
        "$ABORT_DIR" \
        "$TRASH_DIR" \
        "$NAMESPACE_DIR" \
        "$LOG_DIR" \
        "$LOCK_ROOT" \
        "$RECORD_LOCK_ROOT"
}

record_lock_digest() {
    local key_hash="$1"
    local external_id="$2"

    printf '%s' "$key_hash:$external_id" | {
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum | awk '{print $1}'
        elif command -v shasum >/dev/null 2>&1; then
            shasum -a 256 | awk '{print $1}'
        else
            die "sha256sum or shasum is required"
        fi
    }
}

acquire_record_lock() {
    local key_hash="$1"
    local external_id="$2"
    local mode="${3:-exclusive}"
    local attempt
    local digest
    local lock_file

    [[ -z "$RECORD_LOCK_METHOD" ]] || {
        die "internal error: a record lock is already held"
    }

    digest="$(record_lock_digest "$key_hash" "$external_id")"
    lock_file="$RECORD_LOCK_ROOT/$digest.lock"
    RECORD_LOCK_DIR="$RECORD_LOCK_ROOT/$digest.lock.d"

    if command -v flock >/dev/null 2>&1; then
        exec 8>"$lock_file"
        if [[ "$mode" == "shared" ]]; then
            flock -s 8
        else
            flock -x 8
        fi
        RECORD_LOCK_METHOD="flock"
        return 0
    fi

    for attempt in $(seq 1 200); do
        if mkdir "$RECORD_LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$$" > "$RECORD_LOCK_DIR/pid"
            RECORD_LOCK_METHOD="directory"
            return 0
        fi
        sleep 0.05
    done

    die "timed out waiting for record lock"
}

release_record_lock() {
    if [[ "$RECORD_LOCK_METHOD" == "flock" ]]; then
        flock -u 8
        exec 8>&-
    elif [[ "$RECORD_LOCK_METHOD" == "directory" ]]; then
        rm -f -- "$RECORD_LOCK_DIR/pid"
        rmdir -- "$RECORD_LOCK_DIR" 2>/dev/null || true
    fi
    RECORD_LOCK_METHOD=""
    RECORD_LOCK_DIR=""
}

acquire_counter_lock() {
    local attempt

    [[ -z "$COUNTER_LOCK_METHOD" ]] || return 0

    if command -v flock >/dev/null 2>&1; then
        exec 9>"$COUNTER_LOCK_FILE"
        flock -x 9
        COUNTER_LOCK_METHOD="flock"
        return 0
    fi

    for attempt in $(seq 1 200); do
        if mkdir "$COUNTER_LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$$" > "$COUNTER_LOCK_DIR/pid"
            COUNTER_LOCK_METHOD="directory"
            return 0
        fi
        sleep 0.05
    done

    die "timed out waiting for internal ID counter lock"
}

release_counter_lock() {
    if [[ "$COUNTER_LOCK_METHOD" == "flock" ]]; then
        flock -u 9
        exec 9>&-
    elif [[ "$COUNTER_LOCK_METHOD" == "directory" ]]; then
        rm -f -- "$COUNTER_LOCK_DIR/pid"
        rmdir -- "$COUNTER_LOCK_DIR" 2>/dev/null || true
    fi
    COUNTER_LOCK_METHOD=""
}

acquire_maintenance_lock() {
    local blocking="${1:-true}"

    [[ -z "$MAINTENANCE_LOCK_METHOD" ]] || return 0

    if command -v flock >/dev/null 2>&1; then
        exec 7>"$MAINTENANCE_LOCK_FILE"
        if [[ "$blocking" == "true" ]]; then
            flock -x 7
        elif ! flock -n -x 7; then
            exec 7>&-
            return 1
        fi
        MAINTENANCE_LOCK_METHOD="flock"
        return 0
    fi

    if mkdir "$MAINTENANCE_LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$MAINTENANCE_LOCK_DIR/pid"
        MAINTENANCE_LOCK_METHOD="directory"
        return 0
    fi

    [[ "$blocking" == "false" ]] && return 1

    local attempt
    for attempt in $(seq 1 200); do
        if mkdir "$MAINTENANCE_LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$$" > "$MAINTENANCE_LOCK_DIR/pid"
            MAINTENANCE_LOCK_METHOD="directory"
            return 0
        fi
        sleep 0.05
    done

    die "timed out waiting for maintenance lock"
}

release_maintenance_lock() {
    if [[ "$MAINTENANCE_LOCK_METHOD" == "flock" ]]; then
        flock -u 7
        exec 7>&-
    elif [[ "$MAINTENANCE_LOCK_METHOD" == "directory" ]]; then
        rm -f -- "$MAINTENANCE_LOCK_DIR/pid"
        rmdir -- "$MAINTENANCE_LOCK_DIR" 2>/dev/null || true
    fi
    MAINTENANCE_LOCK_METHOD=""
}

cleanup_on_exit() {
    if [[ -n "$TEMP_PAYLOAD_FILE" && -f "$TEMP_PAYLOAD_FILE" ]]; then
        rm -f -- "$TEMP_PAYLOAD_FILE"
    fi

    if [[ -n "$TEMP_MESSAGE_DIR" && -d "$TEMP_MESSAGE_DIR" ]]; then
        find "$TEMP_MESSAGE_DIR" -depth -delete
    fi

    if [[ -n "$TEMP_RECORD_DIR" && -d "$TEMP_RECORD_DIR" ]]; then
        find "$TEMP_RECORD_DIR" -depth -delete
    fi

    release_record_lock
    release_counter_lock
    release_maintenance_lock
}

trap cleanup_on_exit EXIT

validate_external_id() {
    local external_id="$1"

    [[ "$external_id" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || {
        die "external ID may contain only letters, numbers, '.', '_', '+', and '-'"
    }
}

validate_key() {
    local key="$1"
    local invalid_count

    [[ -n "$key" ]] || die "key cannot be empty"
    invalid_count="$(
        printf '%s' "$key" |
            LC_ALL=C tr -d '\41-\176' |
            wc -c |
            tr -d '[:space:]'
    )"
    [[ "$invalid_count" == "0" ]] || {
        die "key must contain only printable ASCII without whitespace"
    }
}

validate_key_hash() {
    local key_hash="$1"

    [[ "$key_hash" =~ ^[0-9a-f]{64}$ ]] || {
        die "invalid internal key hash"
    }
}

hash_key() {
    local key="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$key" | sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$key" | shasum -a 256 | awk '{print $1}'
    else
        die "sha256sum or shasum is required"
    fi
}

read_key_file() {
    local key_file="$1"
    local key

    [[ -f "$key_file" ]] || die "key file not found"
    [[ -r "$key_file" ]] || die "key file is not readable"

    key="$(cat -- "$key_file")"
    [[ -n "$key" ]] || die "key file is empty"
    validate_key "$key"
    printf '%s\n' "$key"
}

resolve_command_key() {
    local supplied_key=""

    if [[ -n "$KEY_FILE_OPTION" ]]; then
        supplied_key="$(read_key_file "$KEY_FILE_OPTION")"
    elif [[ -n "${IAC_QUEUE_KEY+x}" ]]; then
        supplied_key="$IAC_QUEUE_KEY"
        [[ -n "$supplied_key" ]] || die "IAC_QUEUE_KEY is empty"
        validate_key "$supplied_key"
    else
        [[ $# -ge 1 ]] || die "this command requires a key"
        supplied_key="$1"
        validate_key "$supplied_key"
        COMMAND_KEY_ARGUMENT_CONSUMED="true"
    fi

    RESOLVED_KEY_HASH="$(hash_key "$supplied_key")"
    validate_key_hash "$RESOLVED_KEY_HASH"
}

namespace_path() {
    local key_hash="$1"

    validate_key_hash "$key_hash"
    printf '%s/%s\n' "$NAMESPACE_DIR" "$key_hash"
}

namespace_label() {
    local key_hash="$1"
    local label_file
    local label=""

    label_file="$(namespace_path "$key_hash")/label"
    if [[ -f "$label_file" ]]; then
        IFS= read -r label < "$label_file" || true
    fi
    printf '%s\n' "${label:--}"
}

validate_label() {
    local label="$1"
    local byte_count
    local invalid_count

    [[ -n "$label" ]] || die "label cannot be empty; use --clear"
    byte_count="$(printf '%s' "$label" | wc -c | tr -d '[:space:]')"
    (( byte_count <= 256 )) || die "label exceeds maximum size of 256 bytes"

    invalid_count="$(
        printf '%s' "$label" |
            LC_ALL=C tr -d '\40-\176' |
            wc -c |
            tr -d '[:space:]'
    )"
    [[ "$invalid_count" == "0" ]] || {
        die "label must contain printable ASCII without line breaks"
    }
}

append_history() {
    local item_path="$1"
    local action="$2"
    local note="${3:-}"

    printf '%s\t%s\t%s\t%s\n' \
        "$(now_iso)" \
        "$action" \
        "$(actor_name)" \
        "$(sanitize_note "$note")" \
        >> "$item_path/history.log"
}

write_log() {
    local action="$1"
    local external_id="$2"
    local detail="${3:-}"

    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(now_iso)" \
        "$action" \
        "$external_id" \
        "$(actor_name)" \
        "$(sanitize_note "$detail")" \
        >> "$LOG_FILE"
}

migrate_legacy_keys() {
    local state_dir
    local item_path
    local legacy_key
    local key_hash
    local external_id
    local temp_hash_file

    for state_dir in \
        "$BACKLOG_DIR" \
        "$INPROGRESS_DIR" \
        "$COMPLETED_DIR" \
        "$ABORT_DIR"; do
        shopt -s nullglob
        for item_path in "$state_dir"/*; do
            [[ -d "$item_path" ]] || continue
            [[ -f "$item_path/key" ]] || continue

            IFS= read -r legacy_key < "$item_path/key" || true
            validate_key "$legacy_key"
            key_hash="$(hash_key "$legacy_key")"
            external_id="$(cat "$item_path/external_id" 2>/dev/null ||
                basename "$item_path")"
            acquire_record_lock "$key_hash" "$external_id"
            if [[ ! -f "$item_path/key" ]]; then
                release_record_lock
                continue
            fi
            temp_hash_file="$item_path/.key_sha256.$$"
            printf '%s\n' "$key_hash" > "$temp_hash_file"
            mv -- "$temp_hash_file" "$item_path/key_sha256"
            rm -f -- "$item_path/key"
            mkdir -p -- "$(namespace_path "$key_hash")"
            release_record_lock
        done
        shopt -u nullglob
    done
}

allocate_queue_id() {
    local next_number="1"
    local new_next
    local temp_counter

    acquire_counter_lock

    if [[ -f "$NEXT_ID_FILE" ]]; then
        IFS= read -r next_number < "$NEXT_ID_FILE" || true
    fi

    [[ "$next_number" =~ ^[0-9]+$ ]] || {
        die "invalid internal queue counter: $NEXT_ID_FILE"
    }

    QUEUE_NUMBER="$next_number"
    QUEUE_ID="$(printf 'Q%09d' "$((10#$next_number))")"
    new_next="$((10#$next_number + 1))"
    temp_counter="$NEXT_ID_FILE.tmp.$$"
    printf '%s\n' "$new_next" > "$temp_counter"
    mv -- "$temp_counter" "$NEXT_ID_FILE"
    release_counter_lock
}

find_item() {
    local key_hash="$1"
    local external_id="$2"
    local state
    local state_dir
    local candidate
    local candidate_external_id
    local candidate_key_hash

    validate_key_hash "$key_hash"

    ITEM_STATE=""
    ITEM_PATH=""
    ITEM_QUEUE_ID=""

    for state in backlog inprogress completed abort; do
        case "$state" in
            backlog) state_dir="$BACKLOG_DIR" ;;
            inprogress) state_dir="$INPROGRESS_DIR" ;;
            completed) state_dir="$COMPLETED_DIR" ;;
            abort) state_dir="$ABORT_DIR" ;;
        esac

        shopt -s nullglob
        for candidate in "$state_dir"/*; do
            [[ -d "$candidate" ]] || continue
            [[ -f "$candidate/key_sha256" ]] || continue
            [[ -f "$candidate/external_id" ]] || continue
            IFS= read -r candidate_key_hash < "$candidate/key_sha256" || true
            IFS= read -r candidate_external_id < "$candidate/external_id" || true

            if [[ "$candidate_key_hash" == "$key_hash" &&
                  "$candidate_external_id" == "$external_id" ]]; then
                ITEM_STATE="$state"
                ITEM_PATH="$candidate"
                ITEM_QUEUE_ID="$(basename "$candidate")"
                shopt -u nullglob
                return 0
            fi
        done
        shopt -u nullglob
    done

    return 1
}

validate_payload_file() {
    local payload_file="$1"
    local byte_count
    local invalid_count

    [[ -s "$payload_file" ]] || die "message payload cannot be empty"

    byte_count="$(wc -c < "$payload_file" | tr -d '[:space:]')"
    (( byte_count <= MAX_MESSAGE_BYTES )) || {
        die "message exceeds maximum size of $MAX_MESSAGE_BYTES bytes"
    }

    invalid_count="$(
        LC_ALL=C tr -d '\11\12\15\40-\176' < "$payload_file" |
            wc -c |
            tr -d '[:space:]'
    )"

    [[ "$invalid_count" == "0" ]] || {
        die "message must contain only ASCII plaintext"
    }
}

capture_payload() {
    local destination="$1"
    shift

    PAYLOAD_PRESENT="false"
    : > "$destination"

    if [[ $# -eq 0 ]]; then
        return 0
    fi

    case "$1" in
        --file)
            [[ $# -eq 2 ]] || {
                die "message --file requires exactly one FILE"
            }
            [[ -f "$2" ]] || die "message file not found: $2"
            cp -- "$2" "$destination"
            ;;
        --stdin)
            [[ $# -eq 1 ]] || {
                die "message --stdin does not accept other arguments"
            }
            cat > "$destination"
            ;;
        *)
            printf '%s\n' "$*" > "$destination"
            ;;
    esac

    validate_payload_file "$destination"
    PAYLOAD_PRESENT="true"
}

message_count() {
    local item_path="$1"
    local message_path
    local count=0

    shopt -s nullglob
    for message_path in "$item_path/messages"/M*; do
        [[ -d "$message_path" ]] || continue
        count=$((count + 1))
    done
    shopt -u nullglob

    printf '%s\n' "$count"
}

allocate_message_id() {
    local item_path="$1"
    local counter_file="$item_path/next_message_id"
    local next_number="1"
    local next_value
    local temp_counter

    if [[ -f "$counter_file" ]]; then
        IFS= read -r next_number < "$counter_file" || true
    fi

    [[ "$next_number" =~ ^[0-9]+$ ]] || {
        die "invalid message counter for queue record $ITEM_QUEUE_ID"
    }

    MESSAGE_ID="$(printf 'M%09d' "$((10#$next_number))")"
    next_value="$((10#$next_number + 1))"
    temp_counter="$counter_file.tmp.$$"
    printf '%s\n' "$next_value" > "$temp_counter"
    mv -- "$temp_counter" "$counter_file"
}

enqueue_payload() {
    local item_path="$1"
    local payload_file="$2"
    local current_count
    local temp_message
    local final_message

    validate_payload_file "$payload_file"
    mkdir -p "$item_path/messages"
    current_count="$(message_count "$item_path")"

    (( current_count < MAX_MESSAGES )) || {
        die "message queue is full; maximum is $MAX_MESSAGES messages"
    }

    allocate_message_id "$item_path"
    temp_message="$(mktemp -d "$item_path/messages/.tmp.XXXXXX")"
    set_shared_directory_mode "$temp_message"
    TEMP_MESSAGE_DIR="$temp_message"
    printf '%s\n' "$(now_iso)" > "$temp_message/created_at"
    printf '%s\n' "$(actor_name)" > "$temp_message/actor"
    cp -- "$payload_file" "$temp_message/payload.txt"
    final_message="$item_path/messages/$MESSAGE_ID"
    mv -- "$temp_message" "$final_message"
    TEMP_MESSAGE_DIR=""
}

find_oldest_message() {
    local item_path="$1"
    local message_path

    OLDEST_MESSAGE_PATH=""
    OLDEST_MESSAGE_ID=""

    shopt -s nullglob
    for message_path in "$item_path/messages"/M*; do
        [[ -d "$message_path" ]] || continue
        OLDEST_MESSAGE_PATH="$message_path"
        OLDEST_MESSAGE_ID="$(basename "$message_path")"
        break
    done
    shopt -u nullglob

    [[ -n "$OLDEST_MESSAGE_PATH" ]]
}

flush_messages() {
    local item_path="$1"
    local message_path
    local count=0

    shopt -s nullglob
    for message_path in "$item_path/messages"/M*; do
        [[ -d "$message_path" ]] || continue
        find "$message_path" -type f -delete
        rmdir -- "$message_path"
        count=$((count + 1))
    done
    shopt -u nullglob

    FLUSHED_MESSAGES="$count"
}

abort_stale_tasks() {
    local threshold_days="$1"
    local reason="$2"
    local now_epoch
    local threshold_seconds
    local state
    local state_dir
    local item_path
    local queue_id
    local created_epoch
    local age_seconds
    local external_id
    local key_hash
    local destination

    MAINTENANCE_ABORTED_COUNT=0
    now_epoch="$(date '+%s')"
    threshold_seconds="$((threshold_days * 86400))"

    for state in backlog inprogress; do
        case "$state" in
            backlog) state_dir="$BACKLOG_DIR" ;;
            inprogress) state_dir="$INPROGRESS_DIR" ;;
        esac

        shopt -s nullglob
        for item_path in "$state_dir"/*; do
            [[ -d "$item_path" ]] || continue
            [[ -f "$item_path/created_epoch" ]] || continue
            IFS= read -r created_epoch < "$item_path/created_epoch" || true
            [[ "$created_epoch" =~ ^[0-9]+$ ]] || continue

            age_seconds="$((now_epoch - created_epoch))"
            (( age_seconds >= threshold_seconds )) || continue

            [[ -f "$item_path/key_sha256" ]] || continue
            [[ -f "$item_path/external_id" ]] || continue
            IFS= read -r key_hash < "$item_path/key_sha256" || true
            IFS= read -r external_id < "$item_path/external_id" || true
            queue_id="$(basename "$item_path")"
            acquire_record_lock "$key_hash" "$external_id"

            # The task may have changed state while this process waited.
            if [[ ! -d "$item_path" ]]; then
                release_record_lock
                continue
            fi

            flush_messages "$item_path"
            if (( FLUSHED_MESSAGES > 0 )); then
                append_history "$item_path" "messages-flushed" \
                    "$FLUSHED_MESSAGES message(s)"
            fi

            printf '%s\n' "aborted" > "$item_path/result"
            printf '%s\n' "$(now_iso)" > "$item_path/updated_at"
            printf '%s\n' "$(date '+%s')" > "$item_path/terminal_epoch"
            append_history "$item_path" "aborted" \
                "$reason after $threshold_days day(s)"

            destination="$ABORT_DIR/$queue_id"
            mv -- "$item_path" "$destination"
            write_log "aborted" "$external_id" \
                "$queue_id $reason after $threshold_days day(s)"
            MAINTENANCE_ABORTED_COUNT=$((MAINTENANCE_ABORTED_COUNT + 1))
            release_record_lock
        done
        shopt -u nullglob
    done
}

append_gitignore_entry() {
    local gitignore_file="$1"
    local entry="$2"

    if [[ -f "$gitignore_file" ]] && grep -Fqx -- "$entry" "$gitignore_file"; then
        return 0
    fi

    if [[ -s "$gitignore_file" ]]; then
        printf '\n' >> "$gitignore_file"
    fi

    printf '%s\n' "$entry" >> "$gitignore_file"
}

cmd_install() {
    [[ $# -eq 1 ]] || die "install requires one TARGET directory"

    local target
    local install_root
    local destination
    local git_root
    local relative_bin
    local relative_logs
    local relative_trash
    local gitignore_file

    mkdir -p -- "$1"
    target="$(readlink -f "$1")"
    install_root="$target/iac-queue"
    destination="$install_root/bin/iac-queue"

    umask 0007
    mkdir -p \
        "$install_root/bin" \
        "$install_root/logs" \
        "$install_root/logs/locks" \
        "$install_root/logs/locks/records" \
        "$install_root/queue/backlog" \
        "$install_root/queue/inprogress" \
        "$install_root/queue/completed" \
        "$install_root/queue/abort" \
        "$install_root/queue/trash" \
        "$install_root/queue/namespaces"

    set_shared_directory_mode \
        "$install_root/logs" \
        "$install_root/logs/locks" \
        "$install_root/logs/locks/records" \
        "$install_root/queue" \
        "$install_root/queue/backlog" \
        "$install_root/queue/inprogress" \
        "$install_root/queue/completed" \
        "$install_root/queue/abort" \
        "$install_root/queue/trash" \
        "$install_root/queue/namespaces"

    # Upgrade existing installations for shared group operation.
    chmod -R g+rwX "$install_root/logs" "$install_root/queue"

    touch \
        "$install_root/queue/backlog/.gitkeep" \
        "$install_root/queue/inprogress/.gitkeep" \
        "$install_root/queue/completed/.gitkeep" \
        "$install_root/queue/abort/.gitkeep" \
        "$install_root/queue/namespaces/.gitkeep"

    if [[ ! -e "$destination" ||
          "$SELF_PATH" != "$(readlink -f "$destination")" ]]; then
        install -m 0755 "$SELF_PATH" "$destination"
    else
        chmod 0755 "$destination"
    fi

    if git_root="$(git -C "$install_root" rev-parse --show-toplevel 2>/dev/null)"; then
        git_root="$(readlink -f "$git_root")"
        gitignore_file="$git_root/.gitignore"
        relative_bin="${install_root#"$git_root"/}/bin"
        relative_logs="${install_root#"$git_root"/}/logs"
        relative_trash="${install_root#"$git_root"/}/queue/trash"

        append_gitignore_entry "$gitignore_file" "/$relative_bin/"
        append_gitignore_entry "$gitignore_file" "/$relative_logs/"
        append_gitignore_entry "$gitignore_file" "/$relative_trash/"

        printf 'Updated Git ignore file: %s\n' "$gitignore_file"
        printf 'Active and terminal queue data remains visible to Git: %s\n' \
            "$install_root/queue"
        printf 'Trash data is ignored by Git: %s\n' "$install_root/queue/trash"
    else
        printf 'Target is not inside a Git worktree; no .gitignore was changed.\n'
    fi

    printf 'Installed %s at: %s\n' "$PROGRAM" "$destination"
    printf 'Queue directory: %s\n' "$install_root/queue"
}

cmd_add() {
    [[ $# -ge 2 ]] || die "add requires a key and external ID"

    local key_hash="$1"
    local external_id="$2"
    shift 2

    local temp_path
    local created_at
    local initial_payload

    validate_key_hash "$key_hash"
    validate_external_id "$external_id"

    ensure_runtime
    acquire_record_lock "$key_hash" "$external_id"

    if find_item "$key_hash" "$external_id"; then
        printf '%s already exists as %s in %s; add ignored.\n' \
            "$external_id" "$ITEM_QUEUE_ID" "$ITEM_STATE"
        write_log "add-ignored" "$external_id" \
            "$ITEM_QUEUE_ID already in $ITEM_STATE"
        return 0
    fi

    allocate_queue_id
    temp_path="$(mktemp -d "$BACKLOG_DIR/.${QUEUE_ID}.tmp.XXXXXX")"
    set_shared_directory_mode "$temp_path"
    TEMP_RECORD_DIR="$temp_path"
    created_at="$(now_iso)"

    printf '%s\n' "$key_hash" > "$temp_path/key_sha256"
    printf '%s\n' "$external_id" > "$temp_path/external_id"
    printf '%s\n' "$created_at" > "$temp_path/created_at"
    printf '%s\n' "$(date '+%s')" > "$temp_path/created_epoch"
    printf '%s\n' "$QUEUE_NUMBER" > "$temp_path/created_order"
    printf '%s\n' "$created_at" > "$temp_path/updated_at"
    : > "$temp_path/result"
    : > "$temp_path/history.log"
    mkdir -p "$temp_path/messages"

    append_history "$temp_path" "added" ""

    initial_payload="$temp_path/.initial-payload"
    TEMP_PAYLOAD_FILE="$initial_payload"
    capture_payload "$initial_payload" "$@"
    if [[ "$PAYLOAD_PRESENT" == "true" ]]; then
        enqueue_payload "$temp_path" "$initial_payload"
        append_history "$temp_path" "message-pushed" "$MESSAGE_ID"
    fi
    rm -f -- "$initial_payload"
    TEMP_PAYLOAD_FILE=""

    mv -- "$temp_path" "$BACKLOG_DIR/$QUEUE_ID"
    TEMP_RECORD_DIR=""
    mkdir -p -- "$(namespace_path "$key_hash")"

    write_log "added" "$external_id" "$QUEUE_ID backlog"
    printf '%s added to backlog as %s.\n' "$external_id" "$QUEUE_ID"
}

cmd_cancel() {
    [[ $# -ge 2 ]] || die "cancel requires a key and external ID"

    local key_hash="$1"
    local external_id="$2"
    shift 2
    local note="$*"
    local destination

    validate_key_hash "$key_hash"
    validate_external_id "$external_id"
    ensure_runtime
    acquire_record_lock "$key_hash" "$external_id"

    if ! find_item "$key_hash" "$external_id"; then
        printf '%s does not exist; cancel ignored.\n' "$external_id"
        write_log "cancel-ignored" "$external_id" "not found"
        return 0
    fi

    if [[ "$ITEM_STATE" == "completed" || "$ITEM_STATE" == "abort" ]]; then
        printf '%s is already terminal in %s; cancel ignored.\n' \
            "$external_id" "$ITEM_STATE"
        write_log "cancel-ignored" "$external_id" \
            "$ITEM_QUEUE_ID already in $ITEM_STATE"
        return 0
    fi

    flush_messages "$ITEM_PATH"
    if (( FLUSHED_MESSAGES > 0 )); then
        append_history "$ITEM_PATH" "messages-flushed" \
            "$FLUSHED_MESSAGES message(s)"
    fi

    destination="$COMPLETED_DIR/$ITEM_QUEUE_ID"
    mv -- "$ITEM_PATH" "$destination"
    printf '%s\n' "cancelled" > "$destination/result"
    printf '%s\n' "$(now_iso)" > "$destination/updated_at"
    printf '%s\n' "$(date '+%s')" > "$destination/terminal_epoch"
    append_history "$destination" "cancelled" "$note"

    write_log "cancelled" "$external_id" "$ITEM_QUEUE_ID $note"
    printf '%s (%s) moved to completed as cancelled.\n' \
        "$external_id" "$ITEM_QUEUE_ID"
}

cmd_start() {
    [[ $# -ge 2 ]] || die "start requires a key and external ID"

    local key_hash="$1"
    local external_id="$2"
    shift 2
    local note="$*"
    local destination

    validate_key_hash "$key_hash"
    validate_external_id "$external_id"
    ensure_runtime
    acquire_record_lock "$key_hash" "$external_id"

    find_item "$key_hash" "$external_id" || {
        die "task '$external_id' does not exist for the supplied key"
    }

    case "$ITEM_STATE" in
        backlog)
            destination="$INPROGRESS_DIR/$ITEM_QUEUE_ID"
            mv -- "$ITEM_PATH" "$destination"
            printf '%s\n' "$(now_iso)" > "$destination/updated_at"
            append_history "$destination" "started" "$note"
            write_log "started" "$external_id" "$ITEM_QUEUE_ID $note"
            printf '%s (%s) moved to inprogress.\n' \
                "$external_id" "$ITEM_QUEUE_ID"
            ;;
        inprogress)
            printf '%s is already inprogress; start ignored.\n' "$external_id"
            write_log "start-ignored" "$external_id" \
                "$ITEM_QUEUE_ID already inprogress"
            ;;
        completed)
            printf '%s is already completed; start ignored.\n' "$external_id"
            write_log "start-ignored" "$external_id" \
                "$ITEM_QUEUE_ID already completed"
            ;;
        abort)
            printf '%s is aborted; start ignored.\n' "$external_id"
            write_log "start-ignored" "$external_id" \
                "$ITEM_QUEUE_ID already aborted"
            ;;
    esac
}

cmd_complete() {
    [[ $# -ge 2 ]] || die "complete requires a key and external ID"

    local key_hash="$1"
    local external_id="$2"
    shift 2
    local note="$*"
    local destination
    local existing_result

    validate_key_hash "$key_hash"
    validate_external_id "$external_id"
    ensure_runtime
    acquire_record_lock "$key_hash" "$external_id"

    find_item "$key_hash" "$external_id" || {
        die "task '$external_id' does not exist for the supplied key"
    }

    if [[ "$ITEM_STATE" == "completed" ]]; then
        existing_result="$(cat "$ITEM_PATH/result" 2>/dev/null || true)"
        printf '%s is already completed (%s); complete ignored.\n' \
            "$external_id" "${existing_result:-unknown}"
        write_log "complete-ignored" "$external_id" \
            "$ITEM_QUEUE_ID already completed"
        return 0
    fi

    [[ "$ITEM_STATE" != "abort" ]] || {
        die "task '$external_id' is aborted and cannot be completed"
    }

    [[ "$ITEM_STATE" == "inprogress" ]] || {
        die "task '$external_id' is in backlog; run start before complete"
    }

    flush_messages "$ITEM_PATH"
    if (( FLUSHED_MESSAGES > 0 )); then
        append_history "$ITEM_PATH" "messages-flushed" \
            "$FLUSHED_MESSAGES message(s)"
    fi

    destination="$COMPLETED_DIR/$ITEM_QUEUE_ID"
    mv -- "$ITEM_PATH" "$destination"
    printf '%s\n' "success" > "$destination/result"
    printf '%s\n' "$(now_iso)" > "$destination/updated_at"
    printf '%s\n' "$(date '+%s')" > "$destination/terminal_epoch"
    append_history "$destination" "completed" "$note"

    write_log "completed" "$external_id" "$ITEM_QUEUE_ID $note"
    printf '%s (%s) moved to completed as successful.\n' \
        "$external_id" "$ITEM_QUEUE_ID"
}

require_open_task() {
    local key_hash="$1"
    local external_id="$2"

    find_item "$key_hash" "$external_id" || {
        die "task '$external_id' does not exist for the supplied key"
    }

    case "$ITEM_STATE" in
        completed|abort)
            die "task '$external_id' is in $ITEM_STATE; its message queue is closed"
            ;;
    esac
}

cmd_push() {
    [[ $# -ge 3 ]] || {
        die "push requires a key, external ID, and message"
    }

    local key_hash="$1"
    local external_id="$2"
    shift 2
    local payload_file

    validate_key_hash "$key_hash"
    validate_external_id "$external_id"
    ensure_runtime
    acquire_record_lock "$key_hash" "$external_id"
    require_open_task "$key_hash" "$external_id"

    payload_file="$ITEM_PATH/.incoming-message.$$"
    TEMP_PAYLOAD_FILE="$payload_file"
    capture_payload "$payload_file" "$@"
    [[ "$PAYLOAD_PRESENT" == "true" ]] || die "push requires a message"

    enqueue_payload "$ITEM_PATH" "$payload_file"
    rm -f -- "$payload_file"
    TEMP_PAYLOAD_FILE=""
    printf '%s\n' "$(now_iso)" > "$ITEM_PATH/updated_at"
    append_history "$ITEM_PATH" "message-pushed" "$MESSAGE_ID"
    write_log "message-pushed" "$external_id" \
